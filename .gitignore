# environments / caches
.venv/
__pycache__/
*.pyc

# generated outputs
exports/
results/
# per-machine working state (session autosave)
app_data/
# standalone Word deliverables authored outside the repo — kept on disk,
# not version-controlled (the tracked docs are the generated PDF guide and
# the Markdown decision/calibration logs)
docs/*.docx
# intermediate guide figures — regenerated by build_guide.py
docs/_build/

# third-party XFOIL binaries and source archives — not redistributed here
# (GPL); download them into xfoil/ per the README
*.zip
xfoil/*.exe

# local tooling config (kept on disk, not shared)
.claude/

# local editor / OS noise
.vscode/
Thumbs.db
desktop.ini
*.lnk
